// Menciones — modelo de datos (SQLite en desarrollo; para Postgres cambiar provider y adapter)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("user") // user | admin
  consentAt    DateTime  // aceptación de la política de privacidad (Ley 29733)
  emailVerifiedAt DateTime? // null = aún no confirmó su correo (no puede ingresar)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  projects     Project[]
  resets       PasswordReset[]
  verifications EmailVerification[]
}

model EmailVerification {
  id        String    @id // sha256 del token enviado por correo
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id // sha256 del token enviado por correo
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id // sha256 del token de la cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String     @id @default(cuid())
  userId      String?    // null = proyecto del administrador (creado antes de las cuentas) o demo
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String     // marca a monitorear, p.ej. "BCP"
  domain      String     // dominio propio, p.ej. "kaus.pe"
  aliases     String     @default("[]") // JSON string[]: otras formas de escribir la marca
  competitors String     @default("[]") // JSON {name, domain, aliases[]}[]
  country     String     @default("PE") // ISO-2 para búsqueda web localizada
  language    String     @default("es")
  isDemo      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  prompts     Prompt[]
  runs        Run[]

  @@index([userId])
}

model Prompt {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  responses Response[]
}

model Run {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     String     @default("running") // running | done | failed
  mode       String     @default("live")    // live | sandbox | demo
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  costUsd    Float      @default(0)
  errorCount Int        @default(0)
  responses  Response[]

  @@index([startedAt])
}

model Response {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  promptId  String
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  engine    String   // chatgpt | claude | gemini | perplexity
  model     String   @default("")
  text      String   @default("")
  sources   String   @default("[]") // JSON {title,url,domain}[]
  mentions  String   @default("[]") // JSON BrandHit[] (ver src/lib/analysis.ts)
  costUsd   Float    @default(0)
  error     String?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([promptId, engine])
}
