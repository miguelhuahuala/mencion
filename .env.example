DATABASE_URL="file:./dev.db"

# DataForSEO — credenciales de API (NO tu email/clave de la web): https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# true = usa sandbox.dataforseo.com (gratis, datos ficticios)
DATAFORSEO_SANDBOX=false

# Modelos por motor (lista actual: npm run models)
MODEL_CLAUDE=claude-haiku-5-5
MODEL_GEMINI=gemini-3.8-flash
MODEL_PERPLEXITY=sonar

# Opcional: análisis de sentimiento con Claude. Sin clave, solo se detectan menciones.
ANTHROPIC_API_KEY=

# Mostrar el proyecto de demostración (datos ficticios, marcados como tales en la UI)
SHOW_DEMO_DATA=true

# URL pública del sitio
SITE_URL=https://menciones.org

# Opcional: protege TODO el sitio con una contraseña única (útil para un entorno de pruebas). Vacío = sitio público.
APP_PASSWORD=

# Cuentas: correos con rol de administrador (sin límites), separados por coma
ADMIN_EMAILS=
# Plan gratis
FREE_MAX_PROJECTS=1
FREE_MAX_PROMPTS=5
FREE_RUN_INTERVAL_DAYS=7
# Tope de gasto mensual de toda la plataforma en DataForSEO (USD). Al llegar, se pausan las mediciones del plan gratis.
MAX_MONTHLY_SPEND_USD=30
# Solo en producción: permite que Google indexe la landing
ALLOW_INDEXING=false
CONTACT_EMAIL=contacto@menciones.org
# Secreto para /api/cron (genera uno con: openssl rand -hex 24)
CRON_SECRET=

# Correos (recuperar contraseña) con Resend: https://resend.com — verifica el dominio menciones.org primero
RESEND_API_KEY=
EMAIL_FROM=Menciones <no-responder@menciones.org>
